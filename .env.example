# Claude API — required. If you've already run `ant auth login`, you can leave this unset.
ANTHROPIC_API_KEY=

# USAJobs API — free key from https://developer.usajobs.gov/apirequest/. Optional; that source
# is skipped with a notice if unset.
USAJOBS_API_KEY=
USAJOBS_EMAIL=

# Gmail SMTP app password (NOT your real Gmail password) — generate one at
# https://myaccount.google.com/apppasswords (requires 2FA enabled on the account).
# Used by the LOCAL digest (jobcopilot.digest / email_sender.py).
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Gmail API credentials — used by the CLOUD routine (jobcopilot.cloud_send /
# gmail_api_sender.py), which sends over HTTPS instead of SMTP since the sandbox
# blocks SMTP. Get these by running scripts/gmail_oauth_setup.py once (see README.md).
# GMAIL_CLIENT_ID / GMAIL_CLIENT_SECRET also need to be set as secrets on the cloud
# routine's environment, not just here.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Who the morning digest gets sent to. Usually the same as GMAIL_ADDRESS.
DIGEST_RECIPIENT_EMAIL=
